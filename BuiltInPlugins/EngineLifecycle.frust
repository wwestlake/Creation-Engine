manifest "{\"name\":\"engine_lifecycle\",\"version\":\"0.2.0\",\"description\":\"Creation Engine built-in FRust lifecycle and transform capability proof plugin\",\"entryPoints\":[\"on_init\",\"on_event\",\"on_unload\"],\"intendedApplications\":[\"creation-engine\"],\"requiredHostFunctions\":[{\"name\":\"engine_current_tick\",\"description\":\"Reads the authoritative Engine simulation tick.\"},{\"name\":\"engine_first_transform_entity\",\"description\":\"Finds the first Engine entity with a transform.\"},{\"name\":\"engine_set_position_x\",\"description\":\"Sets an entity X position in Engine world units.\"},{\"name\":\"engine_set_material_color_parameter\",\"description\":\"Overrides a named Vector Parameter on an entity's compiled material.\"},{\"name\":\"engine_active_game_id\",\"description\":\"Reads the active Engine game ID.\"},{\"name\":\"engine_active_scene_id\",\"description\":\"Reads the active Engine scene ID.\"},{\"name\":\"engine_request_scene_transition\",\"description\":\"Requests a transition by direct Engine scene reference.\"}]}";

extern fn engine_current_tick() -> i64;
extern fn engine_first_transform_entity() -> i64;
extern fn engine_set_position_x(entity: i64, position_x: i64) -> i64;
extern fn engine_set_material_color_parameter(entity: i64, parameter_name: String, r255: i64, g255: i64, b255: i64) -> i64;
extern fn engine_active_game_id() -> String;
extern fn engine_active_scene_id() -> String;
extern fn engine_request_scene_transition(scene_reference: String) -> i64;

pub fn on_init() -> i64 = {
    engine_current_tick()
}

// on_event ran a one-time proof (a deliberate sawtooth: engine_set_position_x
// driven straight off argument%8, wrapping 0->7->0 every 8 ticks) that the
// transform/tick/material-parameter host-function plumbing actually works
// end to end. It proved out -- and also turned out to be exactly the
// "world slides then snaps back" symptom reported over this session,
// because this plugin auto-loads under the engine's own default plugin
// slot and receives every simulationTick dispatch in every real session,
// not just a deliberate stress-test run. The proof is done; on_event is a
// no-op now so this stress test never runs unless someone puts the two
// engine_set_* calls back deliberately for another one.
pub fn on_event(id: i64, argument: i64) -> i64 = {
    engine_current_tick() + id + argument
}

pub fn on_unload() -> i64 = {
    0
}
