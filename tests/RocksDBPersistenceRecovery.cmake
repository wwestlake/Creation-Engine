if(NOT DEFINED TEST_EXECUTABLE OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "RocksDB recovery test requires an executable and scratch directory")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${TEST_ROOT}/eng-003-recovery-${run_id}")
if(EXISTS "${run}")
    message(FATAL_ERROR "RocksDB recovery scratch directory already exists")
endif()
file(MAKE_DIRECTORY "${run}")

function(check mode directory expected)
    execute_process(COMMAND "${TEST_EXECUTABLE}" "${mode}" "${run}/${directory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 40)
    if(NOT result STREQUAL expected)
        message(FATAL_ERROR "${mode} returned ${result}, expected ${expected}\n${output}\n${error}\nScratch data: ${run}")
    endif()
endfunction()

check(sync durable 71)
check(verify durable 0)
check(abandon durable 73)
check(verify durable 0)
check(provisional durable 72)
check(tear durable 0)
check(verify durable 0)
check(provisional-index durable 74)
check(tear durable 0)
check(verify durable 0)
check(process process 71)
check(verify process 0)
check(portability transfer 0)
file(REMOVE_RECURSE "${run}")
