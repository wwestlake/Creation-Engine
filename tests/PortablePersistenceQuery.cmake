if(NOT DEFINED TEST_EXECUTABLE OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "Portable query test requires an executable and a scratch directory")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
file(REAL_PATH "${TEST_ROOT}" root)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${root}/eng-005-query-${run_id}")
if(EXISTS "${run}")
    message(FATAL_ERROR "Query scratch directory already exists")
endif()
file(MAKE_DIRECTORY "${run}")

function(check mode provider directory expected)
    execute_process(COMMAND "${TEST_EXECUTABLE}" "${mode}" "${provider}" "${run}/${directory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 40)
    if(NOT result STREQUAL expected)
        message(FATAL_ERROR "${provider} ${mode} returned ${result}, expected ${expected}\n${output}\n${error}\nScratch data: ${run}")
    endif()
    if(output)
        string(STRIP "${output}" output)
        message(STATUS "${output}")
    endif()
endfunction()

foreach(provider IN ITEMS memory sqlite rocksdb)
    check(conformance "${provider}" "${provider}-suite" 0)
    if(NOT provider STREQUAL "memory")
        check(seed "${provider}" "${provider}-restart" 71)
        check(verify "${provider}" "${provider}-restart" 0)
        check(interrupt "${provider}" "${provider}-restart" 72)
        check(verify "${provider}" "${provider}-restart" 0)
        check(upgrade "${provider}" "${provider}-restart" 73)
        check(verify-upgraded "${provider}" "${provider}-restart" 0)
    endif()
endforeach()

file(REAL_PATH "${run}" resolved)
cmake_path(IS_PREFIX root "${resolved}" NORMALIZE contained)
if(NOT contained OR resolved STREQUAL root)
    message(FATAL_ERROR "Unexpected query scratch directory: ${resolved}")
endif()
file(REMOVE_RECURSE "${resolved}")
message(STATUS "Portable query conformance and process recovery passed")
